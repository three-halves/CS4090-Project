@page "/event/{ID:guid}"
@rendermode InteractiveServer
@using Db
@using Microsoft.EntityFrameworkCore
@using System.Linq
@inject IDbContextFactory<DatabaseContext> _dbContextFactory
@inject NavigationManager _navigationManager

<style>
    th,
    td {
        border: 1px solid white;
        border-collapse: collapse;
    }
</style>

@* Organizer View *@
@if (_user?.Id == _event.OrganizerId)
{
    <input style="width: 30%" @bind="_event.Title" type="text">
    <br>
    <textarea style="width: 30%" @bind="_event.Description"></textarea>
    <br>
    <select style="width: 30%" @bind="_event.Privacy">
        <option value="@Privacy.PRIVATE">Availability submission is only visible to the organizer.</option>
        <option value="@Privacy.PUBLIC_CUMULATIVE">Availability submission is visible to the organizer and the number of people available at each time is public.</option>
        <option value="@Privacy.PUBLIC_IDENTIFIED">Availability submission is public.</option>
    </select>
    <br>
    <button style="width: 30%" @onclick="SaveDetails">Save</button>
    <br>
    <h3>Top 3 Available Times</h3>
    <div style="margin-bottom: 10px;">
        <label>
            Duration (Hours): 
            <input type="number" @bind="_searchDuration" @bind:after="StateHasChanged" min="0.25" step="0.25" style="width: 60px" />
        </label>
    </div>

    <ul>
        @foreach (var slot in GetTopAvailableSlots())
        {
            <li>@slot</li>
        }
    </ul>

    if (_event.FinalizedStart == null && _event.FinalizedEnd == null)
    {
        <h3>Finalize Schedule</h3>
        @* Final Day Selector *@
        if (_event.DaysOfTheWeek)
        {
            <label for="final-day-select">Day: </label>
            <select id="final-day-select" @bind=@selectedFinalDay>
                <option value="null">Choose...</option>
                @foreach (DateOnly day in _event.Dates)
                {
                    <option value=@day>@day.ToString()</option>
                }
            </select>
        }
        @* Final Time Selectors *@
        <label for="final-start-time-select">Start Time: </label>
        <select id="final-start-time-select" @bind=@selectedFinalStartTime>
            <option value=@(-1)>Choose...</option>
            @for (int time_ = (int)_event.EarliestTime; time_ < (int)_event.LatestTime + 1; time_++)
            {
                <option value=@time_>@($"{time_ / 4:00}{time_ * 15 % 60:00}")</option>
            }
        </select>

        <label for="final-end-time-select">End Time: </label>
        <select id="final-start-time-select" @bind=@selectedFinalEndTime>
            <option value=@(-1)>Choose...</option>
            @for (int time_ = (int)_event.EarliestTime; time_ < (int)_event.LatestTime + 1; time_++)
            {
                <option value=@time_>@($"{time_ / 4:00}{time_ * 15 % 60:00}")</option>
            }
        </select>

        @if (selectedFinalStartTime < selectedFinalEndTime && selectedFinalEndTime != -1 && selectedFinalStartTime != -1 && selectedFinalDay != null)
        {
            <button @onclick="FinalizeTime" >Finalize</button>
        }
        else
        {
            <button disabled>Finalize</button>
        }
    }

}
else
{
    <h1>@(_event.Title)</h1>
    <p>@(_event.Description)</p>
    <p>Availability submission is @(_event.Privacy == Privacy.PRIVATE ? "only visible to the organizer" : _event.Privacy == Privacy.PUBLIC_CUMULATIVE ? "visible to the organizer and the number of people available at each time is public" : "public").</p>
}
@if (_event.Organizer != null)
{
    <p>Organizer: @(_event.Organizer.Name)</p>
}
@if (_user == null)
{
    <p><a href="/">Login</a> to submit availability for this event. </p>
}

@* Attendee View *@
@if ((_user != null || _user?.Id == _event.OrganizerId || _event.Privacy != Privacy.PRIVATE) && _event.FinalizedStart == null && _event.FinalizedEnd == null)
{
    <table>
        @* Year / Day of Week *@
        <tr>
            <th></th>
            @* Attendance Entry *@
            @if (_user != null)
            {
                @for (int date = 0; date < _event.Dates.Count; date++)
                {
                    <th>@(_event.DaysOfTheWeek ? "MTWTFSS"[_event.Dates[date].DayNumber] : _event.Dates[date].ToString("yyyy"))</th>
                }
            }
            @* Attendance View *@
            @if (_user?.Id == _event.OrganizerId || _event.Privacy != Privacy.PRIVATE)
            {
                @for (int date = 0; date < _event.Dates.Count; date++)
                {
                    <th>@(_event.DaysOfTheWeek ? "MTWTFSS"[_event.Dates[date].DayNumber] : _event.Dates[date].ToString("yyyy"))</th>
                }
            }
        </tr>
        @* Month-Day *@
        @if (!_event.DaysOfTheWeek)
        {
            <tr>
                <th></th>
                @* Attendance Entry *@
                @if (_user != null)
                {
                    @for (int date = 0; date < _event.Dates.Count; date++)
                    {
                        <th>@(_event.Dates[date].ToString("MM-dd"))</th>
                    }
                }
                @* Attendance View *@
                @if (_user?.Id == _event.OrganizerId || _event.Privacy != Privacy.PRIVATE)
                {
                    @for (int date = 0; date < _event.Dates.Count; date++)
                    {
                        <th>@(_event.Dates[date].ToString("MM-dd"))</th>
                    }
                }
            </tr>
        }
        @* Pad first hour to 4 rows. *@
        @for (int time = (int)(_event.EarliestTime - _event.EarliestTime % 4); time < (int)_event.EarliestTime; time++)
        {
            <tr>
                @if (time % 4 == 0)
                {
                    <td rowspan="4">@($"{_event.EarliestTime / 4:00}00")</td>
                }
                @for (int date = 0; date < _event.Dates.Count; date++)
                {
                    @if (_user != null)
                    {
                        <td></td>
                    }
                    @if (_user?.Id == _event.OrganizerId || _event.Privacy != Privacy.PRIVATE)
                    {
                        <td></td>
                    }
                }
            </tr>
        }
        @* For each time the event may occur... *@
        @for (int time_ = (int)_event.EarliestTime; time_ < (int)_event.LatestTime; time_++)
        {
            <tr>
                @* Hour *@
                @if (time_ % 4 == 0)
                {
                    <td rowspan="4">@($"{time_ / 4:00}00")</td>
                }
                @* Attendance Entry *@
                @if (_user != null)
                {
                    @for (int date_ = 0; date_ < _event.Dates.Count; date_++)
                    {
                        int time = time_;
                        int date = date_;
                        <td @onmousedown:preventDefault="true" @onmouseenter:preventDefault="true" @onmouseup:preventDefault="true" @onmousedown="@(async _ => await MouseDown(date, time))" @onmouseenter="@(async _ => await MouseEnter(date, time))" @onmouseup="MouseUp" style="background-color: @((InSelection(date, time) || (_attendance != null && (_attendance.Availability[date] & (new UInt128(0, 1) << time)) != 0) && !InDeselection(date, time)) ? "#00bb00" : "#bb0000")"></td>
                    }
                }
                @* Attendance View *@
                @if (_user?.Id == _event.OrganizerId || _event.Privacy != Privacy.PRIVATE)
                {
                    @for (int date_ = 0; date_ < _event.Dates.Count; date_++)
                    {
                        int timeOffset = time_ - (int)_event.EarliestTime;
                        int date = date_;
                        <td @onmouseenter="@(_ => _attendeeTooltip = [date, timeOffset])" style="background-color: color-mix(in oklab, #fff, #090 @(_maxAttendeesAtOnce > 0 ? _attendances[date][timeOffset].Count * 100d / _maxAttendeesAtOnce : 0)%)"></td>
                    }
                }
            </tr>
        }
        @* Pad last hour to 4 rows. *@
        @if (_event.LatestTime % 4 != 0)
        {
            @for (uint i = 0; i < (4 - (_event.LatestTime % 4)); i++)
            {
                <tr>
                    @for (int date = 0; date < _event.Dates.Count; date++)
                    {
                        @if (_user != null)
                        {
                            <td></td>
                        }
                        @if (_user?.Id == _event.OrganizerId || _event.Privacy != Privacy.PRIVATE)
                        {
                            <td></td>
                        }
                    }
                </tr>
            }
        }
    </table>

    @if (_attendance != null)
    {
        <button @onclick="DeleteUserAvailability">Delete My Availability</button>
    }

    @if (_user?.Id == _event.OrganizerId || _event.Privacy == Privacy.PUBLIC_IDENTIFIED)
    {
        <table>
            <tr>
                <th>@($"{_event.Dates[_attendeeTooltip[0]].ToString("yyyy-MM-dd")} {(_attendeeTooltip[1] + _event.EarliestTime) / 4:00}{(_attendeeTooltip[1] + _event.EarliestTime) % 4 * 15:00} - {(_attendeeTooltip[1] + _event.EarliestTime + 1) / 4:00}{(_attendeeTooltip[1] + _event.EarliestTime + 1) % 4 * 15:00}")</th>
            </tr>
            @for (int i = 0; i < _event.Attendees.Count; i++)
            {
                string name = _event.Attendees[i].Name;
                <tr>
                    <td style="background-color: @(_attendances.Count == 0 ? "#555" : _attendances[_attendeeTooltip[0]][_attendeeTooltip[1]].Contains(name) ? "#00bb00" : "#bb0000")">@name</td>
                </tr>
            }
        </table>
    }
}

@if(_event.FinalizedStart != null && _event.FinalizedEnd != null)
{
    <h2>This event has been finalized!</h2>
    <p>Date: @_event.FinalizedStart.Value.Date.ToShortDateString()</p>
    <p>Time: @_event.FinalizedStart.Value.ToString("HHmm") - @_event.FinalizedEnd.Value.ToString("HHmm")</p>
    @if(_user?.Id == _event.OrganizerId)
    {
        <button @onclick="UnfinalizeTime">Un-finalize Event</button>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    [Parameter]
    public Guid ID { get; set; }

    private Event _event = new();
    private List<List<List<string>>> _attendances = [];
    private int _maxAttendeesAtOnce = 0;
    private Attendance? _attendance;
    private User? _user;

    private int[] _attendeeTooltip = [0, 0];

    // start date, start time, end date, end time
    private int[]? _selection;
    private bool _selecting = true;

    private double _searchDuration = 1.0;

    // Currently selected options for organizer's finalized time
    private int selectedFinalEndTime = -1;
    private int selectedFinalStartTime = -1;
    private DateOnly? selectedFinalDay = null;

    private async Task MouseDown(int date, int time)
    {
        if (_user == null) return;
        if (_selection != null)
        {
            await MouseUp(); return;
        }
        // Select if first cell is deselected (which is always the case if the user isn't attending yet) and deselect if first cell is selected.
        _selecting = _attendance == null || (_attendance.Availability[date] & (UInt128.One << time)) == 0;
        _selection = [date, time, date, time];
    }

    private async Task MouseEnter(int date, int time)
    {
        if (_user == null || _selection == null) return;
        _selection[2] = date;
        _selection[3] = time;
        await InvokeAsync(StateHasChanged);
    }

    private async Task MouseUp()
    {
        if (_user == null || _selection == null) return;
        if (_attendance == null)
        {
            // User is not currently attending, add them to this event.
            _attendance = new Attendance
            {
                UserId = _user.Id,
                EventId = _event.Id,
                Availability = Enumerable.Repeat<UInt128>(0, _event.Dates.Count).ToList()
            };
        }
        int minDate = Math.Min(_selection[0], _selection[2]);
        int maxDate = Math.Max(_selection[0], _selection[2]);
        int minTime = Math.Min(_selection[1], _selection[3]);
        int maxTime = Math.Max(_selection[1], _selection[3]);
        if (_selecting)
        {
            // Set bits in selection.
            for (int date = minDate; date <= maxDate; date++)
            {
                for (int time = minTime; time <= maxTime; time++)
                {
                    _attendance.Availability[date] |= UInt128.One << time;
                }
            }
        }
        else
        {
            // Clear bits in selection.
            for (int date = minDate; date <= maxDate; date++)
            {
                for (int time = minTime; time <= maxTime; time++)
                {
                    _attendance.Availability[date] &= ~(UInt128.One << time);
                }
            }
        }
        _selection = null;
        await SaveAttendance();
    }

    private bool InSelection(int date, int time)
    {
        if (_selection == null || !_selecting) return false;
        int minDate = Math.Min(_selection[0], _selection[2]);
        int maxDate = Math.Max(_selection[0], _selection[2]);
        int minTime = Math.Min(_selection[1], _selection[3]);
        int maxTime = Math.Max(_selection[1], _selection[3]);
        return minDate <= date && date <= maxDate && minTime <= time && time <= maxTime;
    }

    private bool InDeselection(int date, int time)
    {
        if (_selection == null || _selecting) return false;
        int minDate = Math.Min(_selection[0], _selection[2]);
        int maxDate = Math.Max(_selection[0], _selection[2]);
        int minTime = Math.Min(_selection[1], _selection[3]);
        int maxTime = Math.Max(_selection[1], _selection[3]);
        return minDate <= date && date <= maxDate && minTime <= time && time <= maxTime;
    }

    protected override async Task OnInitializedAsync()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        Event? event_ = await databaseContext.Events.FindAsync(ID);
        if (event_ == null)
        {
            _navigationManager.NavigateTo("/not-found", true);
            return;
        }

        await databaseContext.Entry(event_).Collection(event_ => event_.Attendees).LoadAsync();
        await databaseContext.Entry(event_).Reference(event_ => event_.Organizer).LoadAsync();
        _event = event_;

        if (authenticationState != null)
        {
            var authState = await authenticationState;
            if (authState?.User.Identity?.Name != null)
            {
                _user = await databaseContext.Users.FindAsync(new Guid(authState.User.Identity.Name));
                if (_user != null)
                    _attendance = await databaseContext.Attendance.FindAsync(_event.Id, _user.Id);
            }
        }

        await UpdateAttendances();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateAttendances()
    {
        Console.Write(String.Join(", ", _attendance?.Availability ?? []));
        _attendances.Clear();
        for (int date = 0; date < _event.Dates.Count; date++)
        {
            _attendances.Add([]);
            for (int timeOffset = 0; timeOffset < _event.LatestTime - _event.EarliestTime; timeOffset++)
                _attendances[date].Add([]);
        }
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        foreach (User user in _event.Attendees)
        {
            Attendance? attendance_ = await databaseContext.Attendance.FindAsync(_event.Id, user.Id);
            if (attendance_ == null) continue;
            for (int date = 0; date < _event.Dates.Count; date++)
                for (int timeOffset = 0; timeOffset < _event.LatestTime - _event.EarliestTime; timeOffset++)
                    if ((attendance_.Availability[date] & (UInt128.One << (timeOffset + (int)_event.EarliestTime))) != 0)
                        _attendances[date][timeOffset].Add(_user?.Id == _event.OrganizerId || _event.Privacy == Privacy.PUBLIC_IDENTIFIED ? user.Name : "");
        }
        _maxAttendeesAtOnce = _attendances.Select(x => x.Select(y => y.Count).Max()).Max();
    }

    private async Task SaveAttendance()
    {
        if (_attendance == null) return;
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        Attendance? attendance = await databaseContext.Attendance.FindAsync(_attendance.EventId, _attendance.UserId);
        if (attendance == null)
            await databaseContext.Attendance.AddAsync(_attendance);
        else
        {
            attendance.Availability = _attendance.Availability;
            databaseContext.Attendance.Update(attendance);
        }
        await databaseContext.SaveChangesAsync();
        await UpdateAttendances();
        await InvokeAsync(StateHasChanged);
    }

    private async void DeleteUserAvailability()
    {
        if (_attendance == null) return;
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.Attendance.Remove(_attendance);
        await databaseContext.SaveChangesAsync();
        _attendance = null;
        await UpdateAttendances();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveDetails()
    {
        if (_user?.Id == _event.OrganizerId)
        {
            using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
            databaseContext.Update(_event);
            await databaseContext.SaveChangesAsync();
        }
    }

    private IEnumerable<string> GetTopAvailableSlots()
    {
        int durationInQuarterHours = (int)Math.Ceiling(_searchDuration * 4);
        if (durationInQuarterHours < 1) durationInQuarterHours = 1;

        var availableSlots = new List<(int DateIndex, int TimeIndex, int Count)>();

        for (int dateIndex = 0; dateIndex < _attendances.Count; dateIndex++)
        {
            var daySlots = _attendances[dateIndex];
            if (daySlots.Count < durationInQuarterHours) continue;

            for (int timeIndex = 0; timeIndex <= daySlots.Count - durationInQuarterHours; timeIndex++)
            {
                // Find intersection of attendees for the requested duration
                HashSet<string>? intersection = null;

                for (int k = 0; k < durationInQuarterHours; k++)
                {
                    var attendeesInSlot = daySlots[timeIndex + k];
                    if (intersection == null)
                    {
                        intersection = new HashSet<string>(attendeesInSlot);
                    }
                    else
                    {
                        intersection.IntersectWith(attendeesInSlot);
                    }
                    
                    if (intersection.Count == 0) break;
                }

                availableSlots.Add((dateIndex, timeIndex, intersection?.Count ?? 0));
            }
        }

        return availableSlots
            .OrderByDescending(x => x.Count)
            .Take(3)
            .Select(x =>
            {
                var date = _event.Dates[x.DateIndex].ToString("yyyy-MM-dd");
                long startVal = _event.EarliestTime + x.TimeIndex;
                long endVal = startVal + durationInQuarterHours;
                
                string startStr = $"{startVal / 4:00}{startVal % 4 * 15:00}";
                string endStr = $"{endVal / 4:00}{endVal % 4 * 15:00}";
                
                return $"{date} {startStr} - {endStr} ({x.Count})";
            });
    }

    private async void FinalizeTime()
    {
        if (_user?.Id != _event.OrganizerId) return;

        // Form datetime objects from selections
        DateTime finalizedStart = new DateTime(
            selectedFinalDay!.Value, 
            TimeOnly.MinValue.AddMinutes(selectedFinalStartTime * 15)
        );

        DateTime finalizedEnd = new DateTime(
            selectedFinalDay!.Value, 
            TimeOnly.MinValue.AddMinutes(selectedFinalEndTime * 15)
        );

        // Update DB entries
        _event.FinalizedStart = finalizedStart;
        _event.FinalizedEnd = finalizedEnd;

        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.Update(_event);
        await databaseContext.SaveChangesAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async void UnfinalizeTime()
    {
        _event.FinalizedStart = null;
        _event.FinalizedEnd = null;

        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.Update(_event);
        await databaseContext.SaveChangesAsync();

        await InvokeAsync(StateHasChanged);
    }
}